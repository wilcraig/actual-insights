    "spendingResponse": {
      "description": "GET /spending?month=YYYY-MM&level=categories|payees|transactions plus the scope fields of the drill (categoryIds comma separated for categories; categoryId for payees; categoryId and payeeId for transactions). Spending is positive money out for the month. level categories returns one item per category in the rollup, level payees one per merchant for the category, level transactions the matching transactions (newest first, at most 100). items is empty at the transactions level, transactions is empty otherwise.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "generatedAt",
        "month",
        "level",
        "title",
        "total",
        "items",
        "transactions"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "generatedAt": {
          "$ref": "#/definitions/generatedAt"
        },
        "month": {
          "$ref": "#/definitions/month"
        },
        "level": {
          "type": "string",
          "enum": [
            "categories",
            "payees",
            "transactions"
          ]
        },
        "title": {
          "$ref": "#/definitions/name"
        },
        "total": {
          "$ref": "#/definitions/money"
        },
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/definitions/spendingItem"
          }
        },
        "transactions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/spendingTransaction"
          }
        }
      }
    },
